#!/usr/bin/env bash
# Vivobook wrapper: toggle night light using the saved warmth amount.
set -euo pipefail

AUTO="${HOME}/.local/bin/omarchy-vivobook-nightlight-auto"
if [[ ! -x "${AUTO}" ]]; then
  AUTO="$(command -v omarchy-vivobook-nightlight-auto || true)"
fi
if [[ ! -x "${AUTO}" ]]; then
  echo "omarchy-toggle-nightlight: omarchy-vivobook-nightlight-auto not found" >&2
  exit 1
fi

if [[ ${1:-} == "--status" ]]; then
  TEMP="$(hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+' | head -n1 || true)"
  if [[ -n "${TEMP}" && "${TEMP}" -lt 6000 ]]; then
    enabled=true
  else
    enabled=false
  fi
  jq -cn --argjson enabled "$enabled" --arg temp "$TEMP" \
    '{enabled:$enabled, temperature:(($temp | tonumber?) // null)}'
  exit 0
fi

CURRENT="$(hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+' | head -n1 || true)"
if [[ -n "${CURRENT}" && "${CURRENT}" -lt 6000 ]]; then
  "${AUTO}" now-off
else
  "${AUTO}" now-on
fi

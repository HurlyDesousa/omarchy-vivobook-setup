#!/bin/bash

# This PixArt pad exposes two Hyprland devices:
#   hid-over-i2c-093a:3016-touchpad  (normal one-finger pointer)
#   hid-over-i2c-093a:3016-mouse    (leftover HID collection)
# Turning the touchpad off leaves only the mouse node, which needs two
# fingers to move and three to click. Screensaver dismisses on a key or
# click without disabling the pad, so `off` is a no-op and `on` only
# restores if a leftover disable is still in effect.

set -euo pipefail

ACTION="${1:-}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/screensaver"
HOLD_FILE="$STATE_DIR/touchpad-held-off"
USER_DISABLED="$HOME/.local/state/omarchy/toggles/hypr/touchpad-disabled.lua"

device="$(omarchy-hw-touchpad 2>/dev/null || true)"

set_enabled() {
  local name="$1" enabled="$2"
  hyprctl eval "hl.device({ name = \"$name\", enabled = $enabled })" >/dev/null
}

restore() {
  rm -f "$HOLD_FILE"
  if [[ -f $USER_DISABLED ]]; then
    return 0
  fi
  [[ -n $device ]] || return 0
  set_enabled "$device" true
}

case "$ACTION" in
off)
  exit 0
  ;;
on)
  restore
  ;;
*)
  echo "Usage: omarchy-screensaver-touchpad on|off" >&2
  exit 1
  ;;
esac

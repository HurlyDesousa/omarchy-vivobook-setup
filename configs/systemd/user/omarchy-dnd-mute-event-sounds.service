[Unit]
Description=Mute PipeWire event/notification streams while Omarchy DND is on
ConditionPathExists=%h/.local/state/omarchy/toggles/notification-sounds-muted

[Service]
Type=simple
ExecStart=%h/.config/omarchy/bin/omarchy-dnd-mute-event-streams
Restart=on-failure
RestartSec=1

[Install]
# Started on demand by omarchy-dnd-sync-sounds; no WantedBy needed.

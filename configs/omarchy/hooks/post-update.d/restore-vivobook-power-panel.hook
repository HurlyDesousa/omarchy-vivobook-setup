#!/bin/bash
# Omarchy post-update hook: re-apply Vivobook power panel QML polish overlay.
set -euo pipefail

for _vb_lib in "/home/hurly/.local/lib/omarchy-vivobook/user-home.sh" \
               "${OMARCHY_VIVOBOOK_SETUP:+$OMARCHY_VIVOBOOK_SETUP/scripts/lib/user-home.sh}"; do
  [[ -n "${_vb_lib}" && -f "${_vb_lib}" ]] && { # shellcheck source=/dev/null
    source "${_vb_lib}"; vivobook_ensure_user_home; break; }
done
[[ "${EUID}" -eq 0 && "${HOME}" == "/root" ]] && export HOME="/home/hurly" OMARCHY_HOME="/home/hurly"

REPO_ROOT="${OMARCHY_VIVOBOOK_SETUP:-${HOME}/src/omarchy-vivobook-setup}"
OVERLAY="${REPO_ROOT}/configs/omarchy/overlays/panels/power"
TARGET="/usr/share/omarchy/shell/plugins/panels/power"
PLUGIN_SRC="${REPO_ROOT}/configs/omarchy/plugins/hurly.power"
PLUGIN_DEST="${HOME}/.config/omarchy/plugins/hurly.power"

# Keep the live hurly.power clone's watt helper in sync (singleton read-draw).
if [[ -d "${PLUGIN_SRC}" ]]; then
  mkdir -p "${PLUGIN_DEST}"
  for f in read-draw manifest.json; do
    [[ -f "${PLUGIN_SRC}/${f}" ]] || continue
    install -m 0755 "${PLUGIN_SRC}/${f}" "${PLUGIN_DEST}/${f}"
    [[ "${f}" == "manifest.json" ]] && chmod 0644 "${PLUGIN_DEST}/${f}" || true
  done
fi

[[ -d "${OVERLAY}" ]] || exit 0

copy_overlay() {
  local src="$1"
  local dest="$2"
  if [[ -w "${TARGET}" ]]; then
    cp "${src}" "${dest}"
  elif command -v sudo >/dev/null 2>&1; then
    sudo cp "${src}" "${dest}"
  else
    echo "restore-vivobook-power-panel.hook: cannot write ${dest} — run with sudo" >&2
    return 1
  fi
}

for f in Panel.qml Model.js; do
  [[ -f "${OVERLAY}/${f}" ]] || continue
  copy_overlay "${OVERLAY}/${f}" "${TARGET}/${f}" || exit 1
done

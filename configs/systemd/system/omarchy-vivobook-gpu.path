[Unit]
Description=Watch Vivobook power mode for GPU pin
# Path units are Before=paths.target (basic.target). After=multi-user.target
# creates an ordering cycle; systemd then deletes a random job to break it,
# which has dropped NetworkManager.service on some boots.
RequiresMountsFor=@OMARCHY_HOME@/.local/state/omarchy/powerprofiles

[Path]
PathExists=@OMARCHY_HOME@/.local/state/omarchy/powerprofiles/vivobook-mode
PathChanged=@OMARCHY_HOME@/.local/state/omarchy/powerprofiles/vivobook-mode
Unit=omarchy-vivobook-gpu.service

[Install]
WantedBy=multi-user.target

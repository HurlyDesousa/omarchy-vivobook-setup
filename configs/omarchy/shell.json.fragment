          "id": "omarchy.clock",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "sw.art.task-manager"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [

#!/bin/bash
# Preserve Omarchy idle.dim support after package updates.
# Desired state: dim=180 (25% brightness), lock=300, screensaver=400.
# Also: keyboard RGB off on dim / restore from ~/.local/state/omarchy/kbd-backlight.
# Do NOT raise lock/screensaver; do NOT use ~10% dim. Never stop x1e-ec-tool.
set -euo pipefail

for _vb_lib in "${HOME}/.local/lib/omarchy-vivobook/user-home.sh" \
               "${OMARCHY_VIVOBOOK_SETUP:+$OMARCHY_VIVOBOOK_SETUP/scripts/lib/user-home.sh}"; do
  [[ -n "${_vb_lib}" && -f "${_vb_lib}" ]] && { # shellcheck source=/dev/null
    source "${_vb_lib}"; vivobook_ensure_user_home; break; }
done

SAFE_APPLY=""
for candidate in \
  "${OMARCHY_VIVOBOOK_SETUP:+$OMARCHY_VIVOBOOK_SETUP/scripts/lib/safe-apply.sh}" \
  "${HOME}/src/omarchy-vivobook-setup/scripts/lib/safe-apply.sh"; do
  [[ -n "${candidate}" && -f "${candidate}" ]] && { SAFE_APPLY="${candidate}"; break; }
done
[[ -n "${SAFE_APPLY}" ]] && { # shellcheck source=/dev/null
  source "${SAFE_APPLY}"; }

REPO_ROOT="${OMARCHY_VIVOBOOK_SETUP:-${HOME}/src/omarchy-vivobook-setup}"
CONFIGS="${REPO_ROOT}/configs"
TARGET="/usr/share/omarchy/shell/plugins/services/idle/Service.qml"
PATCHED="${HOME}/.local/share/omarchy/idle-dim/Service.qml"
BACKUP_DIR="${HOME}/.local/share/omarchy/idle-dim"
PATCH_CANDIDATES=(
  "${CONFIGS}/quickshell/idle.patch"
  "${HOME}/.local/share/omarchy-vivobook-setup/configs/quickshell/idle.patch"
)
HELPER_LOCAL="${HOME}/.local/bin/omarchy-idle-dim"
HELPER_SYSTEM="/usr/local/bin/omarchy-idle-dim"
SHELL_JSON="${HOME}/.config/omarchy/shell.json"
SHELL_FRAGMENT="${CONFIGS}/omarchy/shell.json.fragment"

mkdir -p "${BACKUP_DIR}"

# Ensure idle-dim helper exists (prefer repo inventory over inline heredoc).
if [[ -f "${CONFIGS}/bin/omarchy-idle-dim" ]]; then
  install -m 0755 "${CONFIGS}/bin/omarchy-idle-dim" "${HELPER_LOCAL}"
  if command -v sudo >/dev/null 2>&1; then
    sudo install -m 0755 "${CONFIGS}/bin/omarchy-idle-dim" "${HELPER_SYSTEM}" 2>/dev/null || true
  elif [[ -w /usr/local/bin ]]; then
    install -m 0755 "${CONFIGS}/bin/omarchy-idle-dim" "${HELPER_SYSTEM}" 2>/dev/null || true
  fi
fi

apply_idle_patch() {
  local patch="$1"
  [[ -f "${patch}" && -f "${TARGET}" ]] || return 0

  if [[ ! -f "${BACKUP_DIR}/Service.qml.stock" ]]; then
    cp -a "${TARGET}" "${BACKUP_DIR}/Service.qml.stock"
  fi

  if patch -R -p1 --dry-run -d / < "${patch}" >/dev/null 2>&1; then
    echo "restore-idle-dim: idle Service.qml patch already applied"
    cp -a "${TARGET}" "${PATCHED}" 2>/dev/null || true
    return 0
  fi

  if patch -N -p1 --dry-run -d / < "${patch}" >/dev/null 2>&1; then
    if [[ -w "${TARGET}" ]]; then
      patch -N -p1 -d / < "${patch}"
    elif command -v sudo >/dev/null 2>&1; then
      sudo patch -N -p1 -d / < "${patch}"
    else
      echo "restore-idle-dim: cannot write ${TARGET} — run with sudo" >&2
      return 1
    fi
    cp -a "${TARGET}" "${PATCHED}"
    echo "restore-idle-dim: applied idle patch from ${patch}"
  elif [[ -f "${PATCHED}" ]]; then
    if [[ ! -f "${TARGET}" ]] || ! grep -q 'dimTimeoutSeconds' "${TARGET}" 2>/dev/null \
        || ! grep -q '/usr/local/bin/omarchy-idle-dim' "${TARGET}" 2>/dev/null; then
      if [[ -w "${TARGET}" ]]; then
        cp "${PATCHED}" "${TARGET}"
      elif command -v sudo >/dev/null 2>&1; then
        sudo cp "${PATCHED}" "${TARGET}"
      fi
      echo "restore-idle-dim: restored patched Service.qml from backup"
    fi
  else
    echo "restore-idle-dim: idle patch does not apply cleanly; manual review needed" >&2
    return 1
  fi
}

PATCH=""
for c in "${PATCH_CANDIDATES[@]}"; do
  [[ -n "${c}" && -f "${c}" ]] && { PATCH="${c}"; break; }
done
[[ -n "${PATCH}" ]] && apply_idle_patch "${PATCH}"

if declare -F merge_shell_json_idle_keys >/dev/null 2>&1; then
  merge_shell_json_idle_keys "${SHELL_JSON}" "${SHELL_FRAGMENT}"
elif [[ -f "${SHELL_JSON}" && -f "${SHELL_FRAGMENT}" ]]; then
  python3 - <<'PY' "${SHELL_JSON}" "${SHELL_FRAGMENT}"
import json, sys
from pathlib import Path

dest = Path(sys.argv[1])
fragment = Path(sys.argv[2])
desired = json.loads(fragment.read_text()).get("idle") or {}
if not desired:
    raise SystemExit(0)
data = json.loads(dest.read_text())
idle = data.get("idle") or {}
changed = False
for key, value in desired.items():
    if key not in idle:
        idle[key] = value
        changed = True
    elif idle[key] != value:
        print(f"restore-idle-dim: keeping live idle.{key}={idle[key]} (desired {value})")
if changed:
    data["idle"] = idle
    dest.write_text(json.dumps(data, indent=2) + "\n")
    print("restore-idle-dim: merged missing idle keys into shell.json")
PY
fi

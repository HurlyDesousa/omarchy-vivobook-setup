#!/usr/bin/env bash
# Vivobook: auto night light via hyprsunset profiles (Berlin sunrise/sunset).
# Uses stock omarchy-restart-hyprsunset / hyprctl — no parallel daemon.
set -euo pipefail

LAT="${OMARCHY_NIGHTLIGHT_LAT:-52.52}"
LON="${OMARCHY_NIGHTLIGHT_LON:-13.40}"
TZ_NAME="${OMARCHY_NIGHTLIGHT_TZ:-Europe/Berlin}"
NIGHT_TEMP="${OMARCHY_NIGHTLIGHT_TEMP:-4000}"
TEMP_MIN=2500
TEMP_MAX=5500

STATE_DIR="${OMARCHY_NIGHTLIGHT_STATE_DIR:-${HOME}/.local/state/omarchy/nightlight}"
AUTO_FILE="${STATE_DIR}/auto"
OVERRIDE_FILE="${STATE_DIR}/manual_override"
TEMP_FILE="${STATE_DIR}/temperature"
FILTER_FILE="${STATE_DIR}/filter"
CONF="${HOME}/.config/hypr/hyprsunset.conf"
CONF_BACKUP="${STATE_DIR}/hyprsunset.conf.stock"

mkdir -p "${STATE_DIR}"

read_auto() {
  if [[ -f "${AUTO_FILE}" ]]; then
    tr -d '[:space:]' < "${AUTO_FILE}"
  else
    echo "off"
  fi
}

write_auto() {
  printf '%s\n' "$1" > "${AUTO_FILE}"
}

read_override() {
  if [[ -f "${OVERRIDE_FILE}" ]]; then
    tr -d '[:space:]' < "${OVERRIDE_FILE}"
  else
    echo ""
  fi
}

write_override() {
  if [[ -z "$1" ]]; then
    rm -f "${OVERRIDE_FILE}"
  else
    printf '%s\n' "$1" > "${OVERRIDE_FILE}"
  fi
}

read_filter() {
  if [[ -f "${FILTER_FILE}" ]]; then
    tr -d '[:space:]' < "${FILTER_FILE}"
  else
    if nightlight_is_on; then
      echo "on"
    else
      echo "off"
    fi
  fi
}

write_filter() {
  printf '%s\n' "$1" > "${FILTER_FILE}"
}

is_int() {
  [[ "${1:-}" =~ ^[0-9]+$ ]]
}

clamp_temp() {
  local t="${1:-$NIGHT_TEMP}"
  is_int "$t" || t="$NIGHT_TEMP"
  if (( t < TEMP_MIN )); then
    t=$TEMP_MIN
  fi
  if (( t > TEMP_MAX )); then
    t=$TEMP_MAX
  fi
  printf '%s\n' "$t"
}

read_temp() {
  local t="$NIGHT_TEMP"
  if [[ -f "${TEMP_FILE}" ]]; then
    local f
    f=$(tr -d '[:space:]' < "${TEMP_FILE}")
    if is_int "$f"; then
      t="$f"
    fi
  fi
  clamp_temp "$t"
}

write_temp() {
  printf '%s\n' "$(clamp_temp "$1")" > "${TEMP_FILE}"
}

amount_from_temp() {
  local t range
  t=$(clamp_temp "$1")
  range=$((TEMP_MAX - TEMP_MIN))
  printf '%s\n' $(( (100 * (TEMP_MAX - t) + range / 2) / range ))
}

temp_from_amount() {
  local a="${1:-50}" range
  is_int "$a" || a=50
  if (( a < 0 )); then
    a=0
  fi
  if (( a > 100 )); then
    a=100
  fi
  range=$((TEMP_MAX - TEMP_MIN))
  printf '%s\n' $(( TEMP_MAX - (a * range + 50) / 100 ))
}

current_hypr_temp() {
  hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+' | head -n1 || true
}

nightlight_is_on() {
  local c
  c="$(current_hypr_temp)"
  [[ -n "$c" && "$c" -lt 6000 ]]
}

ensure_hyprsunset() {
  if ! pgrep -x hyprsunset >/dev/null 2>&1; then
    if command -v uwsm-app >/dev/null 2>&1; then
      setsid uwsm-app -- hyprsunset >/dev/null 2>&1 &
    else
      setsid hyprsunset >/dev/null 2>&1 &
    fi
    sleep 1
  fi
}

refresh_indicator() {
  if command -v omarchy-shell >/dev/null 2>&1; then
    omarchy-shell -q nightlight refresh 2>/dev/null || true
  fi
}

backup_stock_conf() {
  if [[ -f "${CONF}" && ! -f "${CONF_BACKUP}" ]]; then
    cp -a "${CONF}" "${CONF_BACKUP}"
  fi
}

restore_stock_conf() {
  restore_stock_conf_files
  restart_hyprsunset
}

restore_stock_conf_files() {
  if [[ -f "${CONF_BACKUP}" ]]; then
    cp -a "${CONF_BACKUP}" "${CONF}"
    return 0
  fi
  if [[ -f /usr/share/omarchy/default/hypr/hyprsunset.conf ]]; then
    cp /usr/share/omarchy/default/hypr/hyprsunset.conf "${CONF}"
  fi
}

restart_hyprsunset() {
  if command -v omarchy-restart-hyprsunset >/dev/null 2>&1; then
    omarchy-restart-hyprsunset
  else
    ensure_hyprsunset
    hyprctl hyprsunset reset 2>/dev/null || true
  fi
}

sun_times_today() {
  python3 - "$LAT" "$LON" "$TZ_NAME" <<'PY'
import math
import sys
from datetime import date, datetime, timedelta
from zoneinfo import ZoneInfo

lat = float(sys.argv[1])
lon = float(sys.argv[2])
tz = ZoneInfo(sys.argv[3])
day = datetime.now(tz).date()

def julian_day(d: date) -> float:
    if d.month <= 2:
        y, m = d.year - 1, d.month + 12
    else:
        y, m = d.year, d.month
    a = y // 100
    b = 2 - a + a // 4
    return int(365.25 * (y + 4716)) + int(30.6001 * (m + 1)) + d.day + b - 1524.5

def solar_times(d: date, latitude: float, longitude: float, zenith: float = 90.833):
    jd = julian_day(d)
    lng_hour = longitude / 15.0
    t_rise = jd - 2451545.0 + 0.0008 - lng_hour / 24.0
    t_set = t_rise

    def calc(tt: float, is_rise: bool) -> float:
        m = (0.9856 * tt) - 3.289
        l = m + (1.916 * math.sin(math.radians(m))) + (0.020 * math.sin(math.radians(2 * m))) + 282.634
        l = (l + 360.0) % 360.0
        ra = math.degrees(math.atan(0.91764 * math.tan(math.radians(l))))
        ra = (ra + 360.0) % 360.0
        lq = math.floor(l / 90.0) * 90.0
        raq = math.floor(ra / 90.0) * 90.0
        ra = ra + (lq - raq)
        ra /= 15.0
        sin_dec = 0.39782 * math.sin(math.radians(l))
        cos_dec = math.cos(math.asin(sin_dec))
        cos_h = (math.cos(math.radians(zenith)) - sin_dec * math.sin(math.radians(latitude))) / (
            cos_dec * math.cos(math.radians(latitude))
        )
        cos_h = max(-1.0, min(1.0, cos_h))
        h = math.degrees(math.acos(cos_h))
        if is_rise:
            h = 360.0 - h
        h /= 15.0
        t_local = h + ra - (0.06571 * tt) - 6.622
        ut = (t_local - lng_hour) % 24.0
        return ut

    rise_ut = calc(t_rise, True)
    set_ut = calc(t_set, False)
    base = datetime(d.year, d.month, d.day, tzinfo=ZoneInfo("UTC"))
    rise = (base + timedelta(hours=rise_ut)).astimezone(tz)
    sunset = (base + timedelta(hours=set_ut)).astimezone(tz)
    return rise.strftime("%H:%M"), sunset.strftime("%H:%M")

rise, sunset = solar_times(day, lat, lon)
print(rise)
print(sunset)
PY
}

write_auto_conf() {
  local rise sunset night
  mapfile -t _times < <(sun_times_today)
  rise="${_times[0]}"
  sunset="${_times[1]}"
  night="$(read_temp)"

  backup_stock_conf
  cat > "${CONF}" <<EOF
# Generated by omarchy-vivobook-nightlight-auto — Berlin (${LAT}N, ${LON}E)
# Civil sunrise → identity (day). Civil sunset → ${night}K (night).

profile {
    time = ${rise}
    identity = true
}

profile {
    time = ${sunset}
    temperature = ${night}
}
EOF
}

apply_temperature() {
  local target="$1"
  local i current
  ensure_hyprsunset
  for i in $(seq 1 10); do
    hyprctl hyprsunset temperature "${target}" >/dev/null 2>&1 || true
    sleep 0.2
    current="$(current_hypr_temp)"
    if [[ "${current}" == "${target}" ]]; then
      break
    fi
  done
}

sync_filter_from_hypr() {
  if nightlight_is_on; then
    write_filter "on"
  else
    write_filter "off"
  fi
}

apply_override_now() {
  local mode="$1"
  if [[ "${mode}" == "on" ]]; then
    apply_temperature "$(read_temp)"
  else
    apply_temperature "6500"
  fi
  sync_filter_from_hypr
  refresh_indicator
}

sync_temp_to_system() {
  local night
  night="$(read_temp)"
  if [[ "$(read_auto)" == "on" ]]; then
    write_auto_conf
  fi
  if nightlight_is_on || [[ "$(read_filter)" == "on" ]]; then
    ensure_hyprsunset
    hyprctl hyprsunset temperature "${night}" >/dev/null
  fi
  refresh_indicator
}

apply_auto() {
  local override
  override="$(read_override)"
  if [[ -n "${override}" ]]; then
    apply_override_now "${override}"
    return 0
  fi

  write_auto_conf
  restart_hyprsunset
  refresh_indicator
}

cmd_on() {
  write_auto "on"
  write_override ""
  write_auto_conf
}

cmd_off() {
  write_auto "off"
  write_override ""
  restore_stock_conf_files
}

cmd_toggle() {
  if [[ "$(read_auto)" == "on" ]]; then
    cmd_off
  else
    cmd_on
  fi
}

cmd_manual() {
  # Called when user toggles via bind or Quickshell while auto may be on.
  local mode="${1:-}"
  [[ -n "${mode}" ]] || return 0
  if [[ "$(read_auto)" != "on" ]]; then
    refresh_indicator
    return 0
  fi
  write_override "${mode}"
  apply_override_now "${mode}"
}

cmd_status() {
  local rise sunset night
  mapfile -t _times < <(sun_times_today)
  rise="${_times[0]}"
  sunset="${_times[1]}"
  night="$(read_temp)"
  printf 'auto=%s override=%s sunrise=%s sunset=%s tz=%s temp=%s amount=%s filter=%s\n' \
    "$(read_auto)" "$(read_override)" "${rise}" "${sunset}" "${TZ_NAME}" \
    "${night}" "$(amount_from_temp "$night")" "$(read_filter)"
}

cmd_temp() {
  if [[ -z "${1:-}" ]]; then
    read_temp
    return 0
  fi
  write_temp "$1"
  sync_temp_to_system
}

cmd_amount() {
  if [[ -z "${1:-}" ]]; then
    amount_from_temp "$(read_temp)"
    return 0
  fi
  write_temp "$(temp_from_amount "$1")"
  sync_temp_to_system
}

cmd_now_on() {
  if [[ "$(read_auto)" == "on" ]]; then
    write_override "on"
  fi
  apply_override_now "on"
}

cmd_now_off() {
  if [[ "$(read_auto)" == "on" ]]; then
    write_override "off"
  fi
  apply_override_now "off"
}

cmd_clear_override_at_boundary() {
  # Daily timer: drop manual override so profiles resume unless user toggled again.
  if [[ "$(read_auto)" == "on" && -n "$(read_override)" ]]; then
    write_override ""
    apply_auto
  elif [[ "$(read_auto)" == "on" ]]; then
    apply_auto
  fi
}

usage() {
  cat <<'EOF'
omarchy-vivobook-nightlight-auto — Berlin auto night light (hyprsunset profiles)

  on | off | toggle     Enable/disable auto schedule
  apply                 Regenerate today's hyprsunset.conf (auto on)
  manual on|off         Record manual override while auto is on
  now-on | now-off      Apply night or day immediately
  temp [K]              Get or set night temperature (2500–5500)
  amount [0-100]        Get or set night-light amount
  status                Print auto state, warmth, and today's sun times
  boundary              Daily refresh (clear stale override, regen conf)

Right-click the bar night-light indicator for the Auto options menu (after overlay install).
EOF
}

main() {
  local cmd="${1:-status}"
  case "${cmd}" in
    on) cmd_on ;;
    off) cmd_off ;;
    toggle) cmd_toggle ;;
    apply) [[ "$(read_auto)" == "on" ]] && apply_auto ;;
    manual) cmd_manual "${2:-}" ;;
    now-on) cmd_now_on ;;
    now-off) cmd_now_off ;;
    temp) cmd_temp "${2:-}" ;;
    amount) cmd_amount "${2:-}" ;;
    status) cmd_status ;;
    boundary) cmd_clear_override_at_boundary ;;
    -h|--help|help) usage ;;
    *) echo "Unknown command: ${cmd}" >&2; usage >&2; exit 1 ;;
  esac
}

main "$@"

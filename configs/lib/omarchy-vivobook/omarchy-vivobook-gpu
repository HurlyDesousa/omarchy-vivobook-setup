#!/bin/bash
# Pin Adreno GPU clocks from the Vivobook tray power mode.
# Full Speed → governor performance, min_freq = max (1250 MHz).
# Power Saver / Balanced / Performance → simple_ondemand, min_freq restored.
set -euo pipefail

if [[ -n "${OMARCHY_POWERPROFILES_STATE_DIR:-}" ]]; then
  STATE_DIR="$OMARCHY_POWERPROFILES_STATE_DIR"
elif [[ -d /home/hurly/.local/state/omarchy/powerprofiles ]]; then
  STATE_DIR=/home/hurly/.local/state/omarchy/powerprofiles
else
  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/powerprofiles"
fi

MODE=""
[[ -r $STATE_DIR/vivobook-mode ]] && MODE=$(tr -d '\r\n' <"$STATE_DIR/vivobook-mode")

GPU=""
for d in /sys/class/devfreq/*; do
  [[ -e $d/governor ]] || continue
  case "$(basename "$d")" in
    *gpu*) GPU=$d; break ;;
  esac
done
[[ -n $GPU && -e $GPU/governor ]] || exit 0

write_sysfs() {
  local path=$1 val=$2
  [[ -e $path ]] || return 1
  printf '%s\n' "$val" >"$path"
}

max_freq=$(tr -d ' \n' <"$GPU/max_freq")
low_freq=$max_freq
if [[ -r $GPU/available_frequencies ]]; then
  low_freq=$(awk '{print $1; exit}' "$GPU/available_frequencies")
fi

case "$MODE" in
  full-speed)
    write_sysfs "$GPU/governor" performance
    write_sysfs "$GPU/min_freq" "$max_freq"
    ;;
  *)
    write_sysfs "$GPU/min_freq" "$low_freq"
    write_sysfs "$GPU/governor" simple_ondemand
    ;;
esac
exit 0

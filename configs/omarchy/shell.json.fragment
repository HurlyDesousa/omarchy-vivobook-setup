{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "hurly.indicators"
        },
        {
          "id": "omarchy.clock",
          "birthYear": 1995,
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "hurly.weather",
          "refreshMinutes": 15
        },
        {
          "id": "sw.art.task-manager"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "worldClock",
          "type": "qml"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "files",
          "type": "qml"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [],
          "hidden": []
        },
        {
          "id": "hegjon.unifi"
        },
        {
          "id": "io.github.hurlydesousa.kite"
        },
        {
          "id": "hurly.notification-history"
        },
        {
          "id": "sw.art.pi-local"
        },
        {
          "id": "sw.art.grok"
        },
        {
          "id": "io.github.hurlydesousa.ai-usage",
          "footerTitle": "Pi",
          "footerDetail": " (local is excluded)",
          "footerLabel": "Qwen 2.5 · 3B",
          "spaceXaiLabel": "Grok 4.6 · 1.5T · Composer 2.5 · 1T"
        },
        {
          "id": "sw.art.autostart"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "hurly.monitor"
        },
        {
          "id": "hurly.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150,
    "screensaverBattery": 150,
    "dim": 180,
    "sleep": 1800
  },
  "plugins": [
    {
      "id": "hurly.idle"
    },
    {
      "id": "hurly.lock"
    },
    {
      "id": "sw.art.kbd-backlight"
    },
    {
      "id": "io.github.cjgarcia1229.monitor-layout"
    },
    {
      "id": "io.voxtype.settings"
    },
    {
      "id": "hurly.notifications"
    }
  ],
  "version": 1,
  "omarchy": {
    "tray": {
      "hidden": [
        "Cursor_status_icon_1"
      ]
    }
  },
  "disabledPlugins": [
    "omarchy.idle",
    "omarchy.lock",
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "hurly.idle",
    "hurly.lock",
    "hurly.monitor",
    "hurly.notifications"
  ]
}

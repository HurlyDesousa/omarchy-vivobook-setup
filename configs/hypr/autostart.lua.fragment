-- Extra autostart processes.
-- Task Manager: persist across reboot/login, bottom-right, half width x quarter height.

-- omarchy-task-manager begin
o.launch_on_start("/home/hurly/.local/bin/omarchy-task-manager")
o.window("art.sw.omarchy.TaskManager", { float = true })
-- omarchy-task-manager end

-- sw.art.autostart begin
-- Generated by omarchy-autostart-apps. Do not edit this block.

hl.on("hyprland.start", function()
  -- Wait 10s so Wi-Fi/DNS are up before launching apps.
  hl.timer(function()
    hl.exec_cmd(o.launch("omarchy-launch-discord"), { workspace = "1 silent" })
    hl.exec_cmd(o.launch("Telegram"), { workspace = "1 silent" })
    hl.exec_cmd(o.launch("omarchy-launch-webapp https://web.whatsapp.com/"), { workspace = "1 silent" })
    hl.exec_cmd(o.launch("thunderbird"), { workspace = "2 silent" })
    hl.exec_cmd(o.launch("brave"), { workspace = "4 silent" })
    hl.exec_cmd(o.launch("/usr/bin/chromium"), { workspace = "5 silent" })
    hl.exec_cmd(o.launch("opera"), { workspace = "6 silent" })
    hl.exec_cmd(o.launch("/usr/lib/firefox/firefox"), { workspace = "7 silent" })
    hl.exec_cmd(o.launch("/home/hurly/.local/bin/cursor"), { workspace = "8 silent" })
    hl.exec_cmd(o.launch("omarchy-launch-webapp https://www.tradingview.com/chart/"), { workspace = "9 silent" })
  end, { timeout = 10000, type = "oneshot" })
end)

o.window("^chrome\\-discord\\.com__channels_@me\\-Default$", { workspace = "1 silent" })
o.window("^TelegramDesktop$", { workspace = "1 silent" })
o.window("^brave\\-web\\.whatsapp\\.com__\\-Default$", { workspace = "1 silent" })
o.window("^chrome\\-web\\.whatsapp\\.com__\\-Default$", { workspace = "1 silent" })
o.window("^thunderbird$", { workspace = "2 silent" })
o.window("^brave\\-browser$", { workspace = "4 silent" })
o.window("^chromium$", { workspace = "5 silent" })
o.window("^Opera$", { workspace = "6 silent" })
o.window("^firefox$", { workspace = "7 silent" })
o.window("^Cursor$", { workspace = "8 silent" })
o.window("^brave\\-www\\.tradingview\\.com__chart_\\-Default$", { workspace = "9 silent" })
o.window("^chrome\\-www\\.tradingview\\.com__chart_\\-Default$", { workspace = "9 silent" })
-- sw.art.autostart end

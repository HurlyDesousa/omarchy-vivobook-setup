#!/bin/bash
# Omarchy post-update hook: restore the Vivobook hurly.power panel clone.
# Live UI is the user plugin (CPU/GPU live watts + cord/battery labels).
# Do not write /usr/share/omarchy — stock omarchy.power stays packaged.
set -euo pipefail

for _vb_lib in "/home/hurly/.local/lib/omarchy-vivobook/user-home.sh" \
               "${OMARCHY_VIVOBOOK_SETUP:+$OMARCHY_VIVOBOOK_SETUP/scripts/lib/user-home.sh}"; do
  [[ -n "${_vb_lib}" && -f "${_vb_lib}" ]] && { # shellcheck source=/dev/null
    source "${_vb_lib}"; vivobook_ensure_user_home; break; }
done
[[ "${EUID}" -eq 0 && "${HOME}" == "/root" ]] && export HOME="/home/hurly" OMARCHY_HOME="/home/hurly"

REPO_ROOT="${OMARCHY_VIVOBOOK_SETUP:-${HOME}/src/omarchy-vivobook-setup}"
PLUGIN_SRC="${REPO_ROOT}/configs/omarchy/plugins/hurly.power"
PLUGIN_DEST="${HOME}/.config/omarchy/plugins/hurly.power"

[[ -d "${PLUGIN_SRC}" ]] || exit 0

mkdir -p "${PLUGIN_DEST}"
for f in Panel.qml Model.js manifest.json read-draw; do
  [[ -f "${PLUGIN_SRC}/${f}" ]] || continue
  cp "${PLUGIN_SRC}/${f}" "${PLUGIN_DEST}/${f}"
done
chmod +x "${PLUGIN_DEST}/read-draw" 2>/dev/null || true

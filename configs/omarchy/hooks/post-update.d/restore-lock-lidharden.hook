#!/usr/bin/env bash
# Omarchy post-update hook: re-apply lock lid-harden patch after omarchy updates.
# TODO: paste verbatim from AsusLaptop (~/.config/omarchy/hooks/post-update.d/restore-lock-lidharden.hook)
#
# Patch:  <repo>/configs/quickshell/lock-lidharden.patch
# Target: /usr/share/omarchy/shell/plugins/lock/Service.qml
# Backup: Service.qml.bak-pre-lidlock-* (on AsusLaptop)
#
# Stub — install-all.sh copies this to ~/.config/omarchy/hooks/post-update.d/

set -euo pipefail

REPO_ROOT="${OMARCHY_VIVOBOOK_SETUP:-${HOME}/src/omarchy-vivobook-setup}"
PATCH="${REPO_ROOT}/configs/quickshell/lock-lidharden.patch"
TARGET="/usr/share/omarchy/shell/plugins/lock/Service.qml"

if [[ ! -f "${PATCH}" ]] || grep -q '^# Quickshell lock lid-harden patch (placeholder)' "${PATCH}" 2>/dev/null; then
  echo "restore-lock-lidharden.hook: patch still placeholder — TODO: INVENTORY" >&2
  exit 0
fi

if [[ ! -f "${TARGET}" ]]; then
  echo "restore-lock-lidharden.hook: target missing ${TARGET} — skip" >&2
  exit 0
fi

if patch --dry-run -R -p1 -d "$(dirname "${TARGET}")" < "${PATCH}" >/dev/null 2>&1; then
  exit 0
fi

# TODO: paste verbatim re-apply logic from AsusLaptop (may require sudo for /usr/share)
patch -p1 -d "$(dirname "${TARGET}")" < "${PATCH}" || {
  echo "restore-lock-lidharden.hook: patch failed — resolve manually (sudo may be required)" >&2
  exit 1
}

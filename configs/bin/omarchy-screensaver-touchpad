#!/bin/bash

# Disable the laptop touchpad while the screensaver is up, without an OSD
# and without Omarchy's persistent touchpad-off toggle. The sibling clickpad
# mouse device stays enabled so a click can still dismiss.

set -euo pipefail

ACTION="${1:-}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/screensaver"
HOLD_FILE="$STATE_DIR/touchpad-held-off"
USER_DISABLED="$HOME/.local/state/omarchy/toggles/hypr/touchpad-disabled.lua"

device="$(omarchy-hw-touchpad 2>/dev/null || true)"
[[ -n $device ]] || exit 0

set_enabled() {
  local name="$1" enabled="$2"
  hyprctl eval "hl.device({ name = \"$name\", enabled = $enabled })" >/dev/null
}

case "$ACTION" in
off)
  if [[ -f $USER_DISABLED ]]; then
    exit 0
  fi
  mkdir -p "$STATE_DIR"
  set_enabled "$device" false
  printf '%s\n' "$device" >"$HOLD_FILE"
  ;;
on)
  if [[ -f $USER_DISABLED ]]; then
    rm -f "$HOLD_FILE"
    exit 0
  fi
  if [[ -f $HOLD_FILE ]]; then
    name="$(cat "$HOLD_FILE")"
    rm -f "$HOLD_FILE"
    [[ -n $name ]] && set_enabled "$name" true
  else
    set_enabled "$device" true
  fi
  ;;
*)
  echo "Usage: omarchy-screensaver-touchpad on|off" >&2
  exit 1
  ;;
esac

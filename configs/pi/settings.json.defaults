{
  "defaultProvider": "llama-local",
  "defaultModel": "Qwen2.5-3B-Instruct-Q4_K_M",
  "defaultThinkingLevel": "off",
  "theme": "dark",
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 12000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "provider": {
      "timeoutMs": 600000,
      "maxRetries": 0
    }
  }
}

#!/bin/bash
# Called on boot (via omarchy-powerprofiles-init) and on AC plug/unplug (udev).
# Runs as root. Must only exec root-owned helpers under /usr/local/lib|/usr/local/bin.
# systemd often starts this with no HOME; never dereference unbound HOME under set -u.
set -euo pipefail

SYS_LIB=/usr/local/lib/omarchy-vivobook
DEFAULT_HOME=/home/hurly

if [[ "${EUID}" -eq 0 ]]; then
  if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    HOME="$(getent passwd "${SUDO_USER}" 2>/dev/null | cut -d: -f6 || true)"
  fi
  : "${HOME:=${DEFAULT_HOME}}"
  export HOME OMARCHY_HOME="${HOME}"
else
  : "${HOME:=${DEFAULT_HOME}}"
  export HOME
  if [[ -f "${HOME}/.local/lib/omarchy-vivobook/user-home.sh" ]]; then
    # shellcheck source=/dev/null
    source "${HOME}/.local/lib/omarchy-vivobook/user-home.sh"
    vivobook_ensure_user_home
  elif [[ -f "${SYS_LIB}/user-home.sh" ]]; then
    # shellcheck source=/dev/null
    source "${SYS_LIB}/user-home.sh"
    vivobook_ensure_user_home
  fi
fi

export OMARCHY_POWERPROFILES_STATE_DIR="${HOME}/.local/state/omarchy/powerprofiles"

SET="${SYS_LIB}/omarchy-powerprofiles-set"
if [[ ! -x "${SET}" ]]; then
  echo "omarchy-vivobook-powerprofiles-autodetect: missing ${SET}" >&2
  exit 1
fi
exec "${SET}" autodetect

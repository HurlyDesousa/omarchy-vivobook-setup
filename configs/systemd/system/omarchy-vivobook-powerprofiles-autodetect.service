[Unit]
Description=Vivobook power profile autodetect (AC→balanced, battery→power-saver)
After=upower.service
Wants=upower.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/omarchy-vivobook-powerprofiles-autodetect
# User session not required; root can set PPD + EC

[Install]
WantedBy=multi-user.target

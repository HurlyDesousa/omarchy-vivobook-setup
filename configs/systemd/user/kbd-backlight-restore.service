# ~/.config/systemd/user/kbd-backlight-restore.service
# Re-applies the last keyboard RGB colour saved by the sw.art.kbd-backlight bar plugin
# (~/.local/state/omarchy/kbd-backlight, JSON) via x1e-ec-tool when the graphical
# session starts. Honours "autostart": false (does nothing). Keyboard backlight only —
# screen dim is handled by the Omarchy/Quickshell idle policy.
#
# Requires x1e-ec-tool at /usr/local/bin/x1e-ec-tool and hurly in the i2c group
# (or passwordless sudo -n). Never stops or restarts the system-level x1e-ec-tool.service.
#
# Enable: systemctl --user daemon-reload && systemctl --user enable kbd-backlight-restore.service

[Unit]
Description=Restore ASUS Vivobook keyboard RGB backlight from Omarchy state (x1e-ec-tool)
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.local/state/omarchy/kbd-backlight

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -c "import json,os,subprocess as s;p=os.path.expanduser('~/.local/state/omarchy/kbd-backlight');d=json.load(open(p));h=d.get('hex');ec='/usr/local/bin/x1e-ec-tool';d.get('autostart',True) and h and (s.call([ec,'kb',h])==0 or s.call(['sudo','-n',ec,'kb',h]))"
SuccessExitStatus=0 1

[Install]
WantedBy=graphical-session.target
